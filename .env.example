# ─── Supabase ────────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — SERVER ONLY. Never exposed to the browser. Required for the
# Admin page's "create user" flow (auth admin API). Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App ─────────────────────────────────────────────────────────────────────
# Public base URL of the deployed app (used by the PDF export in phase 6).
NEXT_PUBLIC_APP_URL=http://localhost:3000
